Subject: fix(express): spread express stops over the runs of the morning

---
 .../Assignment/ExpressAssignmentPolicy.cs                     | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/Quellbrook.Dispatch.Domain/Assignment/ExpressAssignmentPolicy.cs b/src/Quellbrook.Dispatch.Domain/Assignment/ExpressAssignmentPolicy.cs
index 363d216..786119b 100644
