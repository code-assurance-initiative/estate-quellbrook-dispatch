     private static int Score(Route route, bool sameZone) =>
-        (route.Express ? 100 : 0) + (sameZone ? 50 : 0) - (route.Stops.Count * 5);
+        (route.Express ? 100 : 0) + (sameZone ? 50 : 0) - (route.Stops.Count * 10);
