+name: CodeQL
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+    branches: [main]
+  schedule:
+    - cron: "17 4 * * 1"
+
+permissions:
+  contents: read
+
+jobs:
+  analyze:
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    permissions:
+      contents: read
+      security-events: write
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+
+      - uses: actions/setup-dotnet@a98b56852c35b8e3190ac28c8c2271da59106c68 # v6.0.0
+        with:
+          global-json-file: global.json
+
+      - uses: github/codeql-action/init@2892aa5e19bbd11bc0cff5427e3b750a04d9e3c2 # v4.38.2
+        with:
+          languages: csharp
+          build-mode: manual
+          queries: security-and-quality
+
+      - name: Build
+        run: dotnet build Quellbrook.Dispatch.slnx -c Release
+
+      - uses: github/codeql-action/analyze@2892aa5e19bbd11bc0cff5427e3b750a04d9e3c2 # v4.38.2
+        with:
+          category: /language:csharp
diff --git a/.github/workflows/deploy.yml b/.github/workflows/deploy.yml
new file mode 100644
index 0000000..6891030
--- /dev/null
+++ b/.github/workflows/deploy.yml
@@ -0,0 +1,66 @@
+name: Deploy
+
+# Manual, behind the protected "production" environment (required reviewers). Order: migrate the schema with the
+# release's migrations bundle (migrations are additive), then roll out the image by digest, wait for the rollout,
+# and undo it if the new pods never become ready.
+on:
+  workflow_dispatch:
+    inputs:
+      version:
+        description: Release tag to roll out, e.g. v0.3.0
+        required: true
+        type: string
+
+permissions:
+  contents: read
+
+concurrency:
+  group: deploy-production
+  cancel-in-progress: false
+
+jobs:
+  production:
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    environment: production
+    env:
+      VERSION: ${{ inputs.version }}
+      NAMESPACE: quellbrook-dispatch
+    steps:
+      - name: Fetch release artifacts
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          gh release download "$VERSION" --repo "$GITHUB_REPOSITORY" --pattern efbundle --pattern SHA256SUMS --pattern image-digests.txt --dir release
+          (cd release && sha256sum --check SHA256SUMS)
+          gh attestation verify release/efbundle --repo "$GITHUB_REPOSITORY"
+          chmod +x release/efbundle
+
+      - name: Migrate the database
+        env:
+          ConnectionStrings__Dispatch: ${{ secrets.PRODUCTION_DB_MIGRATOR_CONNECTION }}
+        run: ./release/efbundle
+
+      - name: Write kubeconfig
+        env:
+          KUBECONFIG_DATA: ${{ secrets.PRODUCTION_KUBECONFIG }}
+        run: |
+          umask 077
+          printf '%s' "$KUBECONFIG_DATA" > "$RUNNER_TEMP/kubeconfig"
+
+      - name: Roll out
+        env:
+          KUBECONFIG: ${{ runner.temp }}/kubeconfig
+        run: |
+          digest=$(sed -n 's/^dispatch=//p' release/image-digests.txt)
+          kubectl -n "$NAMESPACE" set image deployment/quellbrook-dispatch api="ghcr.io/code-assurance-initiative/quellbrook-dispatch@${digest}"
+          if ! kubectl -n "$NAMESPACE" rollout status deployment/quellbrook-dispatch --timeout=5m; then
+            echo "::error::quellbrook-dispatch did not become ready; rolling back"
+            kubectl -n "$NAMESPACE" rollout undo deployment/quellbrook-dispatch
+            kubectl -n "$NAMESPACE" rollout status deployment/quellbrook-dispatch --timeout=5m
+            exit 1
+          fi
+
+      - name: Remove kubeconfig
+        if: always()
+        run: rm -f "$RUNNER_TEMP/kubeconfig"
diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
new file mode 100644
index 0000000..74a55e3
--- /dev/null
+++ b/.github/workflows/release.yml
@@ -0,0 +1,85 @@
+name: Release
+
+# Publishing a GitHub release for a version tag builds the image (pushed by digest, with provenance and an SBOM) and
+# the EF Core migrations bundle, and attaches the bundle, its SHA-256 checksum (with a build-provenance attestation)
+# and the image digest to the release. Deploying is a separate, manual step (deploy.yml).
+on:
+  release:
+    types: [published]
+
+permissions:
+  contents: read
+
+jobs:
+  release:
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    permissions:
+      contents: write
+      packages: write
+      id-token: write
+      attestations: write
+    env:
+      DOTNET_NOLOGO: true
+      ContinuousIntegrationBuild: true
+      VERSION: ${{ github.event.release.tag_name }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+
+      - uses: actions/setup-dotnet@a98b56852c35b8e3190ac28c8c2271da59106c68 # v6.0.0
+        with:
+          global-json-file: global.json
+
+      - name: Restore (locked) and tools
+        run: |
+          dotnet restore Quellbrook.Dispatch.slnx --locked-mode
+          dotnet tool restore
+
+      - name: Build migrations bundle
+        run: >-
+          dotnet ef migrations bundle
+          --project src/Quellbrook.Dispatch.Infrastructure
+          --startup-project src/Quellbrook.Dispatch.Infrastructure
+          --configuration Release
+          --self-contained --target-runtime linux-x64
+          --output artifacts/efbundle
+
+      - uses: docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069 # v4.4.1
+
+      - uses: docker/login-action@dbcb813823bdd20940b903addbd779551569679f # v4.6.0
+        with:
+          registry: ghcr.io
+          username: ${{ github.actor }}
+          password: ${{ secrets.GITHUB_TOKEN }}
+
+      - name: Build and push image
+        id: image
+        uses: docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc # v7.4.0
+        with:
+          context: .
+          file: src/Quellbrook.Dispatch.Api/Dockerfile
+          push: true
+          provenance: mode=max
+          sbom: true
+          tags: ghcr.io/code-assurance-initiative/quellbrook-dispatch:${{ github.event.release.tag_name }}
+
+      - name: Checksum of the bundle
+        run: |
+          cd artifacts
+          sha256sum efbundle > SHA256SUMS
+
+      - name: Attest build provenance of the bundle
+        uses: actions/attest-build-provenance@4d101475d8b20a2381f78447822ac1eab6504dd8 # v4.2.2
+        with:
+          subject-path: artifacts/efbundle
+
+      - name: Attach to the release
+        env:
+          GH_TOKEN: ${{ github.token }}
+          IMAGE_DIGEST: ${{ steps.image.outputs.digest }}
+        run: |
+          printf 'dispatch=%s\n' "$IMAGE_DIGEST" > artifacts/image-digests.txt
+          gh release upload "$VERSION" artifacts/efbundle artifacts/SHA256SUMS artifacts/image-digests.txt \
+            --repo "$GITHUB_REPOSITORY"
