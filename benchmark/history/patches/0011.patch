+apiVersion: backstage.io/v1alpha1
+kind: Component
+metadata:
+  name: quellbrook-dispatch
+  description: Dispatch service — consignments, routes, drivers and vehicles; consumes order events, publishes dispatch events.
+  annotations:
+    github.com/project-slug: code-assurance-initiative/estate-quellbrook-dispatch
+  tags: [dotnet, postgres, rabbitmq]
+spec:
+  type: service
+  lifecycle: production
+  owner: group:fleet
+  system: quellbrook-operations
+  providesApis:
+    - quellbrook-dispatch-api
+  consumesApis:
+    - quellbrook-orders-events
+  dependsOn:
+    - resource:quellbrook-dispatch-db
+    - resource:quellbrook-event-broker
+---
+apiVersion: backstage.io/v1alpha1
+kind: API
+metadata:
+  name: quellbrook-dispatch-api
+  description: HTTP API of the dispatch service, consumed by the gateway.
+spec:
+  type: openapi
+  lifecycle: production
+  owner: group:fleet
+  system: quellbrook-operations
+  definition:
+    $text: ./contracts/openapi.yaml
