+            Arg.Is(false), Arg.Is(false), Arg.Any<CancellationToken>());
+        await _channel.Received(1).BasicPublishAsync(
+            "quellbrook.events", "orders.order-placed.v1", true, Arg.Any<BasicProperties>(),
